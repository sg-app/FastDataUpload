# =============================================================================
# FastDataUpload - Environment Configuration
# =============================================================================
# Copy this file to ".env" and adjust the values for your environment.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Port the backend Express server listens on (inside the container)
PORT=3001

# Validity of an upload token in minutes
TOKEN_EXPIRY_MINUTES=10

# Maximum allowed file size per file in megabytes.
# High resolution photos from modern phones are often 5-25 MB,
# so 50 MB is a safe default.
MAX_FILE_SIZE_MB=50

# Absolute path inside the container where uploaded files are stored.
# This directory is backed by a Docker volume mount.
UPLOAD_DIR=/app/uploads

# Comma separated list of allowed CORS origins.
# In production behind Nginx Proxy Manager the frontend and API share the
# same origin, so this can stay empty. Use "*" only for local testing.
CORS_ORIGIN=

# Maximum number of files allowed per single upload request
MAX_FILES_PER_REQUEST=20

# -----------------------------------------------------------------------------
# Frontend (build-time variables - consumed by Vite)
# -----------------------------------------------------------------------------
# Public base URL of the application. This is what ends up inside the QR code.
# Leave empty to fall back to the browser origin at runtime.
# Example: https://fastupload.example.com
VITE_APP_URL=

# Label shown on the QR code page (e.g. your company name)
VITE_APP_NAME=FastDataUpload

# -----------------------------------------------------------------------------
# Docker / Nginx Proxy Manager
# -----------------------------------------------------------------------------
# Host port mapped to the web container (Nginx serving the SPA + API proxy).
# Nginx Proxy Manager should forward your domain to this port (or to the
# container name "web" on port 80 if NPM runs in the same Docker network).
WEB_PORT=8080
