# =============================================================================
# FastDataUpload - Environment Configuration
# =============================================================================
# Copy this file to ".env" and adjust the values for your environment.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Upload-Verhalten (Backend, Laufzeit)
# -----------------------------------------------------------------------------
# Validity of an upload token in minutes
TOKEN_EXPIRY_MINUTES=10

# Maximum allowed file size per file in megabytes.
# High resolution photos from modern phones are often 5-25 MB,
# so 50 MB is a safe default.
MAX_FILE_SIZE_MB=50

# Maximum number of files allowed per single upload request
MAX_FILES_PER_REQUEST=20

# Comma separated list of allowed CORS origins.
# Frontend und API werden aus demselben Container/origin ausgeliefert, daher
# kann der Wert leer bleiben. "http://dockersrv:8083" ist also NICHT nötig.
# "Leer" spiegelt die anfragende Origin - praktisch nur für die lokale
# Vite-Entwicklung (Port 3000 -> API 3001). Für den Betrieb empfiehlt sich
# die explizite Angabe der öffentlichen Origin, z. B.
# CORS_ORIGIN=https://upload.example.com
CORS_ORIGIN=

# -----------------------------------------------------------------------------
# HTTPS / Secure Context
# -----------------------------------------------------------------------------
# true  = die App wird über https erreicht (z. B. Nginx Proxy Manager mit
#         Let's Encrypt, "Force SSL"). Dann werden HSTS,
#         Cross-Origin-Opener-Policy, Origin-Agent-Cluster und die
#         CSP-Direktive "upgrade-insecure-requests" ausgeliefert.
# false = reiner http-Zugriff, z. B. http://dockersrv:8083.
#         Diese Header werden dann weggelassen, weil Browser sie auf einem
#         nicht vertrauenswürdigen Origin ("untrustworthy origin") ignorieren.
#         "upgrade-insecure-requests" würde dort sogar JEDE Asset-Anfrage auf
#         https://<host>:<port>/assets/... umschreiben
#         -> net::ERR_SSL_PROTOCOL_ERROR, weil der Port kein TLS spricht.
# Default ist false (http), damit ein LAN-Betrieb ohne TLS out of the box läuft.
HTTPS_ENABLED=false

# -----------------------------------------------------------------------------
# Runtime-Konfiguration des Frontends (Container-Umgebung -> GET /api/config)
# -----------------------------------------------------------------------------
# Öffentliche Basis-URL der App - genau diese URL landet im QR-Code.
# Der Wert wird zur LAUFZEIT gelesen: .env anpassen und "docker compose up -d"
# genügt, ein Rebuild ist nicht nötig. Leer = Browser-Origin.
# Beispiel: https://upload.example.com
APP_URL=

# Anzeigename der App (UI, Seitentitel)
APP_NAME=FastDataUpload

# -----------------------------------------------------------------------------
# Optional: Werte bereits beim Build einbacken (Vite)
# -----------------------------------------------------------------------------
# Nur nötig, wenn das Frontend die Runtime-Konfiguration nicht abrufen kann
# (z. B. statisches Hosting ohne API). APP_URL/APP_NAME oben haben Vorrang.
# -----------------------------------------------------------------------------
# VITE_APP_URL=
# VITE_APP_NAME=FastDataUpload

# -----------------------------------------------------------------------------
# Docker / Nginx Proxy Manager
# -----------------------------------------------------------------------------
# Image, das docker compose verwendet. Der CI/CD-Workflow veröffentlicht nach
# GHCR; für einen reinen lokalen Build z. B. "fastdataupload:latest" setzen.
IMAGE=ghcr.io/sg-app/fastdataupload:latest

# Host-Port, auf den der App-Container gemappt wird (intern immer 3001).
# Nginx Proxy Manager leitet die Domain auf diesen Port weiter.
WEB_PORT=8080
